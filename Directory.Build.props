<Project>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1902;NU1903</WarningsNotAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Package metadata, shared by the two libraries. Nothing here sets a version: the number belongs
       to a release, and CI passes the one a release names. A local `dotnet pack` therefore produces
       the SDK's default 1.0.0, which is a file name and not a claim. Not packable by default either,
       so a project has to ask: the two libraries do, and the benchmarks and the tests never will.
       Each library states its license expression itself, since each carries a different BSD part. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Authors>Evariops</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <!-- PublishRepositoryUrl reads RepositoryUrl off the `origin` remote; PackageProjectUrl has no
         equivalent, so it is written down. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/Evariops/ManagedCompressions</PackageProjectUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- These files sit at the root and belong in every package: the readme because NuGet renders it on
       the package page, NOTICE because the BSD licenses of zstd and lz4 ask that a binary
       distribution reproduce their notices, and LICENSE, which NOTICE refers to. The Pack metadata is
       inert wherever IsPackable stays false. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
