<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- What the libraries share, compiled into each of them as internal types: the memory their unsafe
       code addresses (Shared/PinnedBuffer.cs), guarded in the Checked configuration. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
