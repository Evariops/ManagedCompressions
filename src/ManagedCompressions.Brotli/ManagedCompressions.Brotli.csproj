<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ManagedCompressions.Brotli</RootNamespace>
    <AssemblyName>ManagedCompressions.Brotli</AssemblyName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>A Brotli (RFC 7932) decompressor and compressor in fully managed C#: no native code, no P/Invoke.</Description>
    <PackageTags>brotli;br;compression;rfc7932;aot</PackageTags>
    <!-- The compressor and the tables are derived from brotli 1.1.1, MIT like this library: see NOTICE. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Safe code, but for one file: every access to memory is a checked index into an array or a span.
       src/BannedSymbols.txt bans the escape hatches of Unsafe and MemoryMarshal, and CheckUnsafeKernel
       below keeps unsafe code to Internal/Prefetch.cs, a cache hint that .NET takes as an address only. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UnsafeKernel>Internal/Prefetch.cs</UnsafeKernel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="../BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <!-- Fails the build when a file other than the kernel says unsafe, or silences the banned-API rule. -->
  <Target Name="CheckUnsafeKernel" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_OutsideUnsafeKernel Include="@(Compile)" Exclude="$(UnsafeKernel)" />
      <_UnsafeOutsideKernel Include="@(_OutsideUnsafeKernel)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(FullPath)')), '\bunsafe\b|RS0030'))" />
    </ItemGroup>
    <Error Condition="'@(_UnsafeOutsideKernel)' != ''" Text="Unsafe code outside $(UnsafeKernel): @(_UnsafeOutsideKernel)" />
  </Target>

  <!-- Its own readme on the package page, which covers Brotli alone. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)../../README.md" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ManagedCompressions.Brotli.Tests" />
    <InternalsVisibleTo Include="ManagedCompressions.Fuzz" />
  </ItemGroup>

</Project>
